{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atril",
  "version": "../package.json",
  "identifier": "io.github.imboqqentt.atril",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node tests/serve.mjs 1420",
    "beforeBuildCommand": "node tools/armar-sitio.mjs dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Atril",
        "width": 1360,
        "height": 900,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Daniel Hormazábal",
    "shortDescription": "Editor de partituras",
    "longDescription": "Atril: escribe, reproduce, transpone y exporta partituras para coro, piano e instrumentos.",
    "category": "Music",
    "copyright": "Daniel Hormazábal",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["atril"],
        "name": "Partitura de Atril",
        "description": "Partitura de Atril",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "languages": ["Spanish"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
